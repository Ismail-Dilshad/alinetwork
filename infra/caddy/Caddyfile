# ======================= STAGING =======================
# Flat names (staging-api, not api.staging): Cloudflare's free certificate
# covers only one subdomain level when the proxy is on.

staging.alinetwork.store {
	import security
	import private
	reverse_proxy 127.0.0.1:3100
}

staging-api.alinetwork.store {
	import security
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:4100
}

staging-manage.alinetwork.store {
	import security
	import private
	root * /srv/alinetwork/staging/current/apps/console/dist
	import spa
}

staging-ops.alinetwork.store {
	import security
	import private
	root * /srv/alinetwork/staging/current/apps/admin/dist
	import spa
}
