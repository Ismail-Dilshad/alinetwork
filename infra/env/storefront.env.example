# /srv/alinetwork/secrets/<production|staging>/storefront.env  (chmod 600)
# Runtime settings for the Next.js shop (prod-storefront)

API_INTERNAL_URL=http://127.0.0.1:4000          # server-side calls skip the internet; staging: 4100
NEXT_PUBLIC_API_URL=https://api.alinetwork.store # staging: https://staging-api.alinetwork.store
NEXT_PUBLIC_CDN_URL=https://cdn.alinetwork.store
NEXT_PUBLIC_SITE_URL=https://alinetwork.store    # staging: https://staging.alinetwork.store
REVALIDATE_SECRET=CHANGE_ME
SENTRY_DSN=
