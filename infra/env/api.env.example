# /srv/alinetwork/secrets/<production|staging>/api.env  (chmod 600)
# Read by PM2 (prod-api, prod-worker) via node --env-file

APP_ENV=production                 # production | staging
PUBLIC_API_URL=https://api.alinetwork.store

# --- Data services (all on 127.0.0.1) ---
DATABASE_URL=postgres://alinetwork_prod:CHANGE_ME@127.0.0.1:5432/alinetwork_prod
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0          # staging: port 6380
MEILI_URL=http://127.0.0.1:7700
MEILI_API_KEY=CHANGE_ME                                # scoped key, not the master key
MEILI_INDEX_PREFIX=prod_                               # staging: staging_

# --- Images and files: Cloudflare R2 ---
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=alinetwork-media                             # staging: alinetwork-media-staging
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
PUBLIC_CDN_URL=https://cdn.alinetwork.store

# --- Auth ---
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
WEBAUTHN_RP_ID=alinetwork.store
ALLOWED_ORIGINS=https://alinetwork.store,https://manage.alinetwork.store,https://ops.alinetwork.store

# --- Payment gateways (sandbox keys on staging) ---
FIB_BASE_URL=
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
QICARD_BASE_URL=
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_PUBLIC_KEY_PATH=/srv/alinetwork/secrets/production/qicard_public.pem

# --- Email / SMS / push ---
SMTP_URL=smtp://user:pass@smtp.provider.com:587
MAIL_FROM="AliNetwork <orders@mail.alinetwork.store>"
SMS_PROVIDER_KEY=
EXPO_ACCESS_TOKEN=

# --- Monitoring ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
