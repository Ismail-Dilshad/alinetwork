# /srv/alinetwork/secrets/<production|staging>/build.env  (chmod 600)
# Baked into the static console builds at build time (public values only, no secrets!)

VITE_API_URL=https://api.alinetwork.store        # staging: https://staging-api.alinetwork.store
VITE_CDN_URL=https://cdn.alinetwork.store
VITE_APP_ENV=production                          # staging: staging
VITE_SENTRY_DSN=

NEXT_PUBLIC_API_URL=https://api.alinetwork.store # also needed when building the storefront
NEXT_PUBLIC_CDN_URL=https://cdn.alinetwork.store
NEXT_PUBLIC_SITE_URL=https://alinetwork.store
